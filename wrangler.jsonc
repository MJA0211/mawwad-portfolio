{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mawwad-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/videos/autovalue-demo.mp4",
      "/videos/failurelab-demo.webm",
      "/videos/eicc-demo.mp4",
    ],
  },
}
